#!/usr/bin/env sh
# Wrapper della CLI llmpod con Docker: esegue i comandi nel container, avvia i client sull'host.
set -eu
# Risolve i link simbolici (senza readlink -f, assente su macOS vecchi) per trovare la radice del progetto.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# Non si cambia la cartella corrente: i client partono da dove l'utente ha lanciato il wrapper.
LLMPOD_ROOT="$ROOT"
. "$ROOT/scripts/lib.sh"

# Comandi gestiti dal wrapper, senza passare dal container.
case "${1:-}" in
  ui)
    echo "Nel setup Docker l'interfaccia la avvia scripts/start" >&2
    exit 1 ;;
  chat)
    # Su un host diverso da 127.0.0.1 (quello della UI): il cookie di sessione della UI non viene inviato a Open WebUI.
    CHAT_URL="http://localhost:${LLMPOD_OPENWEBUI_PORT:-3000}"
    echo "Open WebUI: $CHAT_URL"
    if [ "$(uname -s)" = "Darwin" ]; then open "$CHAT_URL" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$CHAT_URL" >/dev/null 2>&1 || true
    fi
    exit 0 ;;
esac

llmpod_env

TTY=-T
if [ -t 0 ] && [ -t 1 ]; then TTY=-it; fi

if [ "${1:-}" = "docker-logs" ]; then
  # Diagnosi: ultimi log del container (servizio predefinito llmpod), seguiti. Nei log c'è anche il link dell'interfaccia
  # con il token. "logs" invece è il comando della CLI (log di vLLM del profilo) e passa al container.
  exec docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" logs --tail 200 -f "${2:-llmpod}"
fi

client=""
if [ "${1:-}" = "claude" ]; then client=claude; shift
elif [ "${1:-}" = "run" ] && [ -n "${2:-}" ]; then
  # "run --help" e simili: opzione, non client -> comando normale nel container
  case "$2" in
    -*) ;;
    *) client="$2"; shift 2 ;;
  esac
fi

case "$client" in
  "")
    exec docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" run --rm "$TTY" llmpod "$@" ;;
  zcode)
    if command -v pgrep >/dev/null 2>&1 && pgrep -x ZCode >/dev/null 2>&1; then
      echo "Chiudi ZCode e riprova: lo riscrive all'uscita e le modifiche andrebbero perse" >&2
      exit 1
    fi
    llmpod_compose run --rm -T llmpod run zcode --no-open "$@"
    if [ "$(uname -s)" = "Darwin" ]; then open -a ZCode >/dev/null 2>&1 || true; fi ;;
  *)
    # L'output di prepare contiene la chiave del profilo: non va mai stampato né scritto su file, solo valutato.
    # Se prepare fallisce si esce con lo stesso codice, senza eseguire nulla.
    rc=0
    SCRIPT="$(llmpod_compose run --rm -T llmpod prepare "$client" --format sh --host-config-dir "$LLMPOD_CONFIG_DIR" --host-pi-dir "$PI_DIR" "$@")" || rc=$?
    if [ "$rc" -ne 0 ]; then exit "$rc"; fi
    # Si valuta solo uno script fatto di righe "export ..." / "exec ...": altro = risposta inattesa (non stampata).
    if printf '%s\n' "$SCRIPT" | grep -qv -e '^export ' -e '^exec '; then
      echo "Risposta inattesa da prepare: non eseguita" >&2
      exit 1
    fi
    eval "$SCRIPT" ;;
esac
